<?xml version="1.0" encoding="utf-8"?>
<!-- A rank in the list: completed or locked. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="12dp" />
    <gradient
        android:angle="0"
        android:startColor="@color/rank_panel_light"
        android:endColor="@color/rank_panel" />
    <stroke
        android:width="1dp"
        android:color="@color/rank_edge" />
</shape>
