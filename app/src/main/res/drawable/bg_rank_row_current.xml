<?xml version="1.0" encoding="utf-8"?>
<!-- The player's current rank in the list: warm gold glow and a gold edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="12dp" />
    <gradient
        android:angle="0"
        android:startColor="#FF4A3A14"
        android:centerColor="#FF2A2412"
        android:endColor="@color/rank_panel" />
    <stroke
        android:width="2dp"
        android:color="@color/rank_gold" />
</shape>
