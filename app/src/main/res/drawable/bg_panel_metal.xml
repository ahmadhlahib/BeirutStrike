<?xml version="1.0" encoding="utf-8"?>
<!-- A brushed-metal panel with a thin gold edge (career header, home rank card). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/rank_panel_light"
                android:endColor="@color/rank_panel" />
            <stroke
                android:width="1dp"
                android:color="#99E8B64A" />
        </shape>
    </item>
    <!-- A faint sheen across the top half. -->
    <item android:bottom="40dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape>
            <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" />
            <gradient
                android:angle="270"
                android:startColor="#12FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
