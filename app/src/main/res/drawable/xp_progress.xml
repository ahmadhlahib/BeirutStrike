<?xml version="1.0" encoding="utf-8"?>
<!-- The XP bar: a dark track filled with gold. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5dp" />
            <solid android:color="#FF0A0D10" />
            <stroke
                android:width="1dp"
                android:color="@color/rank_edge" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <!-- Fills from the start: left to right, or right to left in Arabic. -->
        <clip
            android:clipOrientation="horizontal"
            android:gravity="start">
            <shape>
                <corners android:radius="5dp" />
                <gradient
                    android:angle="90"
                    android:startColor="@color/rank_gold_dark"
                    android:centerColor="@color/rank_gold"
                    android:endColor="@color/rank_gold_light" />
            </shape>
        </clip>
    </item>
</layer-list>
