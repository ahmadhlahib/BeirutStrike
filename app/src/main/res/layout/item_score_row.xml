<?xml version="1.0" encoding="utf-8"?>
<!-- One scoreboard line (a player or a team), also used for the column headings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/scoreRank"
        style="@style/ScoreCell"
        android:layout_width="28dp"
        android:gravity="start" />

    <!-- Team colour. -->
    <View
        android:id="@+id/scoreSwatch"
        android:layout_width="6dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp" />

    <!-- Player rows: face with a star for Commanders. -->
    <include
        android:id="@+id/scoreFace"
        layout="@layout/view_face_badge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.2"
        android:orientation="vertical">

        <TextView
            android:id="@+id/scoreName"
            style="@style/ScoreCell"
            android:layout_width="match_parent"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Military rank from career XP: "Lv 10 · Captain". -->
        <TextView
            android:id="@+id/scoreArmyRank"
            style="@style/ScoreCell"
            android:layout_width="match_parent"
            android:maxLines="1"
            android:textColor="#AAFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/scoreTeam"
        style="@style/ScoreCell"
        android:layout_width="0dp"
        android:layout_weight="1.8"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1" />

    <TextView android:id="@+id/scorePoints" style="@style/ScoreNumber" />
    <TextView android:id="@+id/scoreKills" style="@style/ScoreNumber" />
    <TextView android:id="@+id/scoreDeaths" style="@style/ScoreNumber" />
    <TextView android:id="@+id/scoreRatio" style="@style/ScoreNumber" />
    <TextView android:id="@+id/scoreShots" style="@style/ScoreNumber" />
    <TextView android:id="@+id/scoreAccuracy" style="@style/ScoreNumber" />
    <TextView android:id="@+id/scoreHitsTaken" style="@style/ScoreNumber" />
</LinearLayout>
