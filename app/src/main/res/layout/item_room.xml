<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Thumbnail of the room's map. -->
        <ImageView
            android:id="@+id/roomMapPreview"
            android:layout_width="84dp"
            android:layout_height="56dp"
            android:background="#FFD8D2C4"
            android:contentDescription="@string/room_map"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/roomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/roomPlayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FF888888" />

            <!-- Rooms that allow cheats: just for fun, scores don't count toward the ranking. -->
            <TextView
                android:id="@+id/roomCheats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/room_cheats_badge"
                android:textColor="#FFFFB300"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Rooms with a minimum rank: its badge and "Captain or higher". -->
            <LinearLayout
                android:id="@+id/roomMinRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/roomMinRankBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />

                <TextView
                    android:id="@+id/roomMinRankText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/roomLock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/room_locked"
            android:src="@drawable/ic_lock"
            app:tint="#FF888888" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
