<?xml version="1.0" encoding="utf-8"?>
<!--
    Ranks / career: the player's rank, level and XP towards the next rank at the top, their career
    stats, then all 20 ranks (completed, current and locked). See CareerActivity.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/careerScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_career"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="@string/career_title"
            android:textColor="@color/rank_gold"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- The player and their rank. -->
        <LinearLayout
            android:id="@+id/careerHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel_metal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/careerFace"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="#FF3A3F47"
                    android:contentDescription="@string/face_photo"
                    android:padding="1dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="@color/rank_gold"
                    app:strokeWidth="1.5dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/careerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:textAllCaps="true"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/careerTotalXp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/rank_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="180dp"
                android:layout_height="150dp"
                android:layout_marginTop="6dp">

                <View
                    android:id="@+id/careerGlow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rank_glow" />

                <ImageView
                    android:id="@+id/careerBadge"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </FrameLayout>

            <TextView
                android:id="@+id/careerRankArabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#AA000000"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textColor="@color/rank_gold_light"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/careerRankEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:textAllCaps="true"
                android:textColor="@color/rank_silver"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/careerLevel"
                style="@style/RankLevelChip"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/careerXp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/careerXpToNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/rank_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/careerProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:max="1000"
                android:progressDrawable="@drawable/xp_progress" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#22FFFFFF" />

            <!-- The next rank, or MAX RANK at the top. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/careerNextLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.15"
                        android:textColor="@color/rank_text_dim"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/careerNextArabic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/careerNextEnglish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true"
                        android:textColor="@color/rank_silver"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/careerNextBadge"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:alpha="0.55" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/RankHeading"
            android:text="@string/career_stats" />

        <LinearLayout
            android:id="@+id/careerStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rank_row"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/careerStatsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/career_stats_offline"
            android:textColor="@color/rank_text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/careerXpRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/rank_text_dim"
            android:textSize="12sp" />

        <TextView
            style="@style/RankHeading"
            android:text="@string/career_all_ranks" />

        <LinearLayout
            android:id="@+id/careerRanks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
