<?xml version="1.0" encoding="utf-8"?>
<!-- Choose who to play as: a turning 3D preview, the characters, and whether your face goes on it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_city_gradient"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/character_title"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <android.opengl.GLSurfaceView
            android:id="@+id/characterPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Shown while a character's model loads. -->
        <ProgressBar
            android:id="@+id/characterLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/characterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="#99000000"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Characters with dances: a small round button per dance under the preview, to watch it. -->
    <LinearLayout
        android:id="@+id/characterDances"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <!-- One card per character, filled in by CharacterActivity. -->
        <LinearLayout
            android:id="@+id/characterList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/characterFaceSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/character_face_switch"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/characterFaceHelper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#BBFFFFFF"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/characterNext"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="@string/character_next"
        android:textColor="#FF212121"
        android:textSize="18sp"
        app:backgroundTint="#FFFFB300"
        app:cornerRadius="14dp" />
</LinearLayout>
