<?xml version="1.0" encoding="utf-8"?>
<!-- One rank in the career list: status icon, badge, level and names, then its status. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_rank_row"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/rankStatusIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/rankBadge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rankLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:textColor="@color/rank_text_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rankArabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rankEnglish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:textColor="@color/rank_silver"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rankStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:letterSpacing="0.08"
        android:maxWidth="120dp"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
