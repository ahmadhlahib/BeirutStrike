<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <android.opengl.GLSurfaceView
        android:id="@+id/glView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Flashes red when a bullet hits the player. -->
    <View
        android:id="@+id/damageFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#88FF1744"
        android:clickable="false"
        android:focusable="false" />

    <!-- Aim: bullets go wherever the centre of the screen points; red over an enemy. -->
    <ImageView
        android:id="@+id/crosshair"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:clickable="false"
        android:contentDescription="@string/aim"
        android:focusable="false"
        android:src="@drawable/ic_crosshair" />

    <!-- Looking through the AK-47's scope. Under the buttons, so they still work. -->
    <com.example.beirutrun.city.ScopeOverlayView
        android:id="@+id/scopeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Blinded by a flashbang: white, fading back. Over the scope, under the buttons. -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFFFF"
        android:clickable="false"
        android:focusable="false" />

    <!-- "Killed by …" / "You killed …!" messages. -->
    <TextView
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="80dp"
        android:alpha="0"
        android:background="#AA000000"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playerButton"
            style="@style/HudButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_person" />

        <!-- Online status and how many other players are in the city. -->
        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- My health: one heart per hit I can still take, and beside it the medkits I carry. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hearts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.1"
                android:shadowColor="#CC000000"
                android:shadowRadius="4"
                android:textColor="#FFFF5252"
                android:textSize="20sp" />

            <!-- A small medkit gives a heart back, a big one fills them all. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/medkitSmallButton"
                style="@style/HudButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:fontFeatureSettings="tnum"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:textSize="13sp"
                app:backgroundTint="#B3000000"
                app:icon="@drawable/ic_medkit"
                app:iconPadding="4dp"
                app:iconSize="18dp"
                app:iconTint="#FFFF5252" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/medkitBigButton"
                style="@style/HudButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:fontFeatureSettings="tnum"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:textSize="13sp"
                app:backgroundTint="#B3B71C1C"
                app:icon="@drawable/ic_medkit"
                app:iconPadding="4dp"
                app:iconSize="18dp" />
        </LinearLayout>
    </LinearLayout>

    <com.example.beirutrun.city.MiniMapView
        android:id="@+id/miniMap"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp" />

    <!--
        Left of the minimap, at the top:

                                   [view]
            (nade) (kind) (mic) (speaker)
                          [⇄ AK-47 · 30]

        Kept narrow (the gun under the others, not beside the view button) so nothing
        reaches the timer at the top centre.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="152dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- Switches between seeing your soldier from behind and seeing through their eyes. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewModeButton"
            style="@style/HudButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            app:icon="@drawable/ic_eye" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Throw a grenade, and the kind to throw with how many are left (tap to change). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/grenadeButton"
                style="@style/HudRoundButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/grenade_throw"
                app:icon="@drawable/ic_grenade" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grenadeKindButton"
                style="@style/HudRoundButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/grenade_kind"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:lineSpacingMultiplier="0.9"
                android:maxLines="2"
                android:textSize="10sp" />

            <!-- Team voice chat: my mic on/off, and mute all teammates. Online only. -->
            <LinearLayout
                android:id="@+id/voiceButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/micButton"
                    style="@style/HudRoundButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/voice_mic"
                    app:icon="@drawable/ic_mic_off"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/speakerButton"
                    style="@style/HudRoundButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/voice_speaker"
                    app:icon="@drawable/ic_volume_up"
                    app:iconSize="18dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- The gun in hand with its rounds; tap to switch guns. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/weaponButton"
            style="@style/HudButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            app:icon="@drawable/ic_swap" />
    </LinearLayout>

    <!-- Time left in the room's game; tap for the scoreboard. Hidden in rooms without a time limit. -->
    <TextView
        android:id="@+id/gameTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:background="#99000000"
        android:fontFeatureSettings="tnum"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="50dp"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:text="@string/look_hint"
        android:textColor="#DDFFFFFF"
        android:textSize="13sp" />

    <!-- Required credit for the OpenStreetMap map data (ODbL). -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:shadowColor="#CC000000"
        android:shadowRadius="4"
        android:text="@string/osm_attribution"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp" />

    <com.example.beirutrun.city.JoystickView
        android:id="@+id/joystick"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp" />

    <!--
        Just above the joystick, centred over it: one button that opens Say and Drop photo
        above it; picking one (or tapping it again) closes them. To its right, a second Shoot
        button for the left thumb.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/sayOrDropButton"
        style="@style/HudRoundButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="66dp"
        android:layout_marginBottom="182dp"
        android:contentDescription="@string/say_or_drop"
        app:icon="@drawable/ic_chat" />

    <LinearLayout
        android:id="@+id/sayOrDropChoices"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="66dp"
        android:layout_marginBottom="252dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sayButton"
            style="@style/HudButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/say"
            app:icon="@drawable/ic_chat" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dropButton"
            style="@style/HudButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:text="@string/drop_photo"
            app:icon="@drawable/ic_camera" />
    </LinearLayout>

    <!-- Shoot for the left thumb: right of the chat button; works like the big one (hold, slide to aim). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/shootButtonLeft"
        style="@style/HudRoundButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="132dp"
        android:layout_marginBottom="172dp"
        android:contentDescription="@string/shoot"
        app:backgroundTint="#DDD32F2F"
        app:icon="@drawable/ic_target"
        app:iconSize="34dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewPhotoButton"
        style="@style/HudButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:backgroundTint="#DDFFB300"
        app:icon="@drawable/ic_photo" />

    <!-- At an arms store's counter: open the shop. Above Climb. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/storeButton"
        style="@style/HudButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="128dp"
        android:text="@string/store_open"
        android:visibility="gone"
        app:backgroundTint="#DD2E7D32"
        app:icon="@drawable/ic_store" />

    <!-- At the foot of a ladder (or beside its top on a roof): climb up or down. Above View photo. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/climbButton"
        style="@style/HudButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="76dp"
        android:visibility="gone"
        app:backgroundTint="#DDE5A823"
        app:icon="@drawable/ic_ladder" />

    <!--
        Right-hand controls. Shoot sits under the minimap, with nothing to its left, so the
        thumb can drag there (or on Shoot itself) to aim while firing:

                                       [minimap]
                                        (SHOOT)
                                     (jump)(crawl)

                       (zoom+)
                       (zoom-)  (scope)  (reload)
    -->

    <!-- AK-47: hold to keep firing. Pistol: one shot per tap. Drag on it to aim while firing. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/shootButton"
        style="@style/HudRoundButton"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="33dp"
        android:contentDescription="@string/shoot"
        app:backgroundTint="#DDD32F2F"
        app:icon="@drawable/ic_target"
        app:iconSize="40dp" />

    <!-- Jump and crawl: a small pair just under Shoot. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="246dp"
        android:layout_marginEnd="29dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/jumpButton"
            style="@style/HudRoundButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/jump"
            app:icon="@drawable/ic_jump"
            app:iconSize="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crawlButton"
            style="@style/HudRoundButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/crawl"
            app:icon="@drawable/ic_crawl"
            app:iconSize="22dp" />
    </LinearLayout>

    <!-- Reload: bottom right corner. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/reloadButton"
        style="@style/HudRoundButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/reload"
        app:icon="@drawable/ic_reload"
        app:iconSize="24dp" />

    <!-- Only with a scope and the AK-47 in hand: left of Reload. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/scopeButton"
        style="@style/HudRoundButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/scope"
        android:visibility="gone"
        app:icon="@drawable/ic_scope" />

    <!-- Through a scope with more than one magnification: zoom in and out, left of Scope. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/zoomInButton"
        style="@style/HudRoundButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="144dp"
        android:layout_marginBottom="72dp"
        android:contentDescription="@string/zoom_in"
        android:visibility="gone"
        app:icon="@drawable/ic_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/zoomOutButton"
        style="@style/HudRoundButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="144dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/zoom_out"
        android:visibility="gone"
        app:icon="@drawable/ic_zoom_out" />
</FrameLayout>
