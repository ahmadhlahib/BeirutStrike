<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <android.opengl.GLSurfaceView
        android:id="@+id/glView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Flashes red when a bullet hits the player. -->
    <View
        android:id="@+id/damageFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#88FF1744"
        android:clickable="false"
        android:focusable="false" />

    <!-- Aim: bullets go wherever the centre of the screen points; red over an enemy. -->
    <ImageView
        android:id="@+id/crosshair"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:clickable="false"
        android:contentDescription="@string/aim"
        android:focusable="false"
        android:src="@drawable/ic_crosshair" />

    <!-- Looking through the AK-47's scope. Under the buttons, so they still work. -->
    <com.example.beirutrun.city.ScopeOverlayView
        android:id="@+id/scopeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- "Killed by …" / "You killed …!" messages. -->
    <TextView
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="80dp"
        android:alpha="0"
        android:background="#AA000000"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playerButton"
            style="@style/HudButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_person" />

        <!-- Online status and how many other players are in the city. -->
        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- My health: one heart per hit I can still take. -->
        <TextView
            android:id="@+id/hearts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.1"
            android:shadowColor="#CC000000"
            android:shadowRadius="4"
            android:textColor="#FFFF5252"
            android:textSize="20sp" />
    </LinearLayout>

    <com.example.beirutrun.city.MiniMapView
        android:id="@+id/miniMap"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp" />

    <!-- Switches between seeing your soldier from behind and seeing through their eyes. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewModeButton"
        style="@style/HudButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="152dp"
        app:icon="@drawable/ic_eye" />

    <!-- Time left in the room's game; tap for the scoreboard. Hidden in rooms without a time limit. -->
    <TextView
        android:id="@+id/gameTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:background="#99000000"
        android:fontFeatureSettings="tnum"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="50dp"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:text="@string/look_hint"
        android:textColor="#DDFFFFFF"
        android:textSize="13sp" />

    <!-- Required credit for the OpenStreetMap map data (ODbL). -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:shadowColor="#CC000000"
        android:shadowRadius="4"
        android:text="@string/osm_attribution"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp" />

    <com.example.beirutrun.city.JoystickView
        android:id="@+id/joystick"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp" />

    <!-- Drop photo: just above the joystick, centred over it. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/dropButton"
        style="@style/HudRoundButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="66dp"
        android:layout_marginBottom="182dp"
        android:contentDescription="@string/drop_photo"
        app:icon="@drawable/ic_camera" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewPhotoButton"
        style="@style/HudButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:backgroundTint="#DDFFB300"
        app:icon="@drawable/ic_photo" />

    <!--
        Right-hand controls, kept low so nothing reaches the minimap (top right):

                        [⇄ AK-47 · 30]
         (say)  (jump)  (  SHOOT  )
        (scope) (crawl)
    -->

    <!-- AK-47: hold to keep firing. Pistol: one shot per tap. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/shootButton"
        style="@style/HudRoundButton"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/shoot"
        app:backgroundTint="#DDD32F2F"
        app:icon="@drawable/ic_target"
        app:iconSize="40dp" />

    <!-- Just above Shoot: reload, and the gun in hand with its rounds (tap to switch guns). -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="132dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reloadButton"
            style="@style/HudRoundButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/reload"
            app:icon="@drawable/ic_reload"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/weaponButton"
            style="@style/HudButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:fontFeatureSettings="tnum"
            app:icon="@drawable/ic_swap" />
    </LinearLayout>

    <!-- Through a scope with more than one magnification: zoom in and out, left of Say and Scope. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/zoomInButton"
        style="@style/HudRoundButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="244dp"
        android:layout_marginBottom="72dp"
        android:contentDescription="@string/zoom_in"
        android:visibility="gone"
        app:icon="@drawable/ic_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/zoomOutButton"
        style="@style/HudRoundButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="244dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/zoom_out"
        android:visibility="gone"
        app:icon="@drawable/ic_zoom_out" />

    <!-- Jump and crawl: a column just left of Shoot. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="116dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/jumpButton"
            style="@style/HudRoundButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/jump"
            app:icon="@drawable/ic_jump" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crawlButton"
            style="@style/HudRoundButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/crawl"
            app:icon="@drawable/ic_crawl" />
    </LinearLayout>

    <!-- Say: left of Jump. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/sayButton"
        style="@style/HudRoundButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="180dp"
        android:layout_marginBottom="72dp"
        android:contentDescription="@string/say"
        app:icon="@drawable/ic_chat" />

    <!-- Only with a scope and the AK-47 in hand: left of Crawl. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/scopeButton"
        style="@style/HudRoundButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="180dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/scope"
        android:visibility="gone"
        app:icon="@drawable/ic_scope" />
</FrameLayout>
