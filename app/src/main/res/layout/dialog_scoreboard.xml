<?xml version="1.0" encoding="utf-8"?>
<!-- The scoreboard: team totals, then every player's stats. Shown full screen over the city. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0101418"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/scoreTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Time left, or the winner once the game is over. -->
    <TextView
        android:id="@+id/scoreSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFFFC107"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/teamsHeading"
                style="@style/ScoreHeading"
                android:text="@string/score_teams" />

            <LinearLayout
                android:id="@+id/teamRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/ScoreHeading"
                android:text="@string/score_players" />

            <LinearLayout
                android:id="@+id/playerRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/scoreEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/score_empty"
                android:textColor="#AAFFFFFF"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scoreRanking"
            style="@style/HudButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/ranking_title"
            android:visibility="gone" />

        <!-- Only once the game is over: straight to creating the next room. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/scoreNewRoom"
            style="@style/HudButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/score_new_room"
            android:visibility="gone"
            app:backgroundTint="#FFFFB300"
            android:textColor="#FF212121" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scoreLeave"
            style="@style/HudButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/menu_leave_room" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scoreClose"
            style="@style/HudButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/close" />
    </LinearLayout>
</LinearLayout>
