<?xml version="1.0" encoding="utf-8"?>
<!-- One gun on the loadout screen: its picture, name, and how it compares. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="230dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#E6101418"
    app:cardCornerRadius="14dp"
    app:strokeColor="#FFFFB300"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- A photo of the gun (see GunPhotos), or a drawing of it when there's none. -->
        <ImageView
            android:id="@+id/gunPicture"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:adjustViewBounds="false"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/gunName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- "30 × 4 rounds · 600/min · reload 2.6 s · 4× scope" -->
        <TextView
            android:id="@+id/gunFacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#BBFFFFFF"
            android:textSize="12sp" />

        <!-- Bars comparing the guns in this slot: damage, fire rate, range, accuracy, mobility. -->
        <LinearLayout
            android:id="@+id/gunStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- Not owned yet: its price, to buy it (owned guns hide this). -->
        <TextView
            android:id="@+id/gunPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#33FFB300"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFC107"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
