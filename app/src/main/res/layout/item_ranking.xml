<?xml version="1.0" encoding="utf-8"?>
<!-- One player in the ranking: position, face (★ for Commanders), name and rank, career numbers. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#CC101418"
    app:cardCornerRadius="14dp"
    app:strokeColor="#FFFFC107"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/rankingPosition"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/rankingFace"
            layout="@layout/view_face_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rankingName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Army rank: Commander or Soldier. -->
            <TextView
                android:id="@+id/rankingArmyRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView android:id="@+id/rankingScore" style="@style/RankingNumber" android:textStyle="bold" />
        <TextView android:id="@+id/rankingShots" style="@style/RankingNumber" />
        <TextView android:id="@+id/rankingKills" style="@style/RankingNumber" />
        <TextView android:id="@+id/rankingAccuracy" style="@style/RankingNumber" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
