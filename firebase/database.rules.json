{
  "rules": {
    "roomList": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && !newData.exists() && (root.child('roomList/' + $room + '/createdBy').val() === auth.uid || (!root.child('roomList/' + $room + '/online').exists() && (root.child('rooms/' + $room + '/members/' + auth.uid).exists() || (root.child('roomList/' + $room + '/lastActive').exists() ? root.child('roomList/' + $room + '/lastActive').val() : root.child('roomList/' + $room + '/createdAt').val()) < now - 300000)))",
        "name": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "hasPassword": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isBoolean()"
        },
        "createdBy": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber()"
        },
        "map": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "duration": {
          ".write": "auth != null && !data.exists() && newData.parent().child('createdBy').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 30000 && newData.val() <= 3600000"
        },
        "cheats": {
          ".write": "auth != null && !data.exists() && newData.parent().child('createdBy').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "startedAt": {
          ".write": "auth != null && !data.exists() && root.child('rooms/' + $room + '/members/' + auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "lastActive": {
          ".write": "auth != null && (root.child('rooms/' + $room + '/members/' + auth.uid).exists() || newData.parent().parent().parent().child('rooms/' + $room + '/members/' + auth.uid).exists())",
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "online": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $room + '/members/' + auth.uid).exists()",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "roomKeys": {
      "$room": {
        ".read": false,
        ".write": "auth != null && ((!data.exists() && newData.parent().parent().child('roomList/' + $room + '/createdBy').val() === auth.uid) || (!newData.exists() && (root.child('roomList/' + $room + '/createdBy').val() === auth.uid || (!root.child('roomList/' + $room + '/online').exists() && (root.child('rooms/' + $room + '/members/' + auth.uid).exists() || (root.child('roomList/' + $room + '/lastActive').exists() ? root.child('roomList/' + $room + '/lastActive').val() : root.child('roomList/' + $room + '/createdAt').val()) < now - 300000)))))",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && data.child('members/' + auth.uid).exists()",
        ".write": "auth != null && !newData.exists() && (root.child('roomList/' + $room + '/createdBy').val() === auth.uid || (!root.child('roomList/' + $room + '/online').exists() && (root.child('rooms/' + $room + '/members/' + auth.uid).exists() || (root.child('roomList/' + $room + '/lastActive').exists() ? root.child('roomList/' + $room + '/lastActive').val() : root.child('roomList/' + $room + '/createdAt').val()) < now - 300000)))",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('roomList/' + $room).exists() || newData.parent().parent().parent().parent().child('roomList/' + $room + '/createdBy').val() === auth.uid) && (!newData.exists() || (root.child('roomKeys/' + $room).exists() ? newData.val() === root.child('roomKeys/' + $room).val() : (newData.parent().parent().parent().parent().child('roomKeys/' + $room).exists() ? newData.val() === newData.parent().parent().parent().parent().child('roomKeys/' + $room).val() : newData.val() === 'open')))",
            ".validate": "newData.isString()"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $room + '/members/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['name', 'x', 'z'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "team": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "say": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "x": { ".validate": "newData.isNumber()" },
            "z": { ".validate": "newData.isNumber()" }
          }
        },
        "drops": {
          "$id": {
            ".write": "auth != null && root.child('rooms/' + $room + '/members/' + auth.uid).exists() && (data.exists() ? data.child('authorId').val() === auth.uid : newData.child('authorId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['x', 'z', 'author', 'authorId'])",
            "caption": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "author": { ".validate": "newData.isString() && newData.val().length <= 40" }
          }
        },
        "dropPhotos": {
          "$id": {
            ".write": "auth != null && root.child('rooms/' + $room + '/members/' + auth.uid).exists() && (root.child('rooms/' + $room + '/drops/' + $id + '/authorId').val() === auth.uid || newData.parent().parent().child('drops/' + $id + '/authorId').val() === auth.uid)",
            ".validate": "newData.isString() && newData.val().length < 1500000"
          }
        },
        "stats": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $room + '/members/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "team": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "kills": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "deaths": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "shots": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "hits": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "hitsTaken": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          }
        },
        "pickups": {
          "$slot": {
            ".write": "auth != null && root.child('rooms/' + $room + '/members/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['kind', 'x', 'z', 'takenAt'])",
            "kind": { ".validate": "newData.val() === 'ak_ammo' || newData.val() === 'pistol_ammo' || newData.val() === 'scope'" },
            "x": { ".validate": "newData.isNumber()" },
            "z": { ".validate": "newData.isNumber()" },
            "takenAt": { ".validate": "newData.isNumber()" },
            "takenBy": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "$other": { ".validate": false }
          }
        },
        "hits": {
          "$victim": {
            "$hit": {
              ".write": "auth != null && root.child('rooms/' + $room + '/members/' + auth.uid).exists() && ((!data.exists() && newData.child('from').val() === auth.uid) || (!newData.exists() && auth.uid === $victim))",
              ".validate": "newData.hasChildren(['from', 'at'])"
            }
          }
        }
      }
    },
    "reports": {
      ".read": false,
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['kind', 'by', 'target', 'at']) && newData.child('by').val() === auth.uid",
        "kind": { ".validate": "newData.val() === 'photo' || newData.val() === 'message' || newData.val() === 'player'" },
        "target": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "targetName": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "detail": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "room": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },
    "career": {
      ".read": "auth != null",
      ".indexOn": ["hits"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "team": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "kills": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "deaths": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "shots": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "hits": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "hitsTaken": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "updated": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },
    "faces": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "data": { ".validate": "newData.isString() && newData.val().length < 200000" }
      }
    }
  }
}
